{
    "name": "consulta-previa",
    "private": true,
    "version": "1.0.125",
    "type": "module",
    "scripts": {
        "upgrade": "npx npm-check-updates -u --reject eslint --reject eslint-plugin-react --reject eslint-plugin-react-hooks --reject eslint-plugin-react-refresh && npm i",
        "format": "npx prettier --write . --tab-width 4 && python .\\src\\utils\\format.py",
        "dev": "vite --port 7153 --host",
        "dev:testing": "vite --port 7153 --host --mode testing",
        "build": "vite build --outDir ../consulta-previa-proxy --emptyOutDir",
        "build:testing": "vite build --mode testing --outDir ../consulta-previa-proxy --emptyOutDir",
        "start": "npx serve ../consulta-previa-proxy",
        "lint": "eslint .",
        "preview": "vite preview",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.2.10",
        "@isoflow/isopacks": "^0.0.10",
        "@marsidev/react-turnstile": "^1.4.2",
        "@mui/icons-material": "^7.3.8",
        "@mui/joy": "^5.0.0-beta.52",
        "@mui/material": "^7.3.8",
        "@mui/x-date-pickers": "^8.27.2",
        "@opentelemetry/api": "^1.9.0",
        "@sentry/browser": "^10.41.0",
        "@sentry/react": "^10.41.0",
        "@uidotdev/usehooks": "^2.4.1",
        "@vercel/speed-insights": "^1.3.1",
        "ahooks": "^3.9.6",
        "browser-image-compression": "^2.0.2",
        "dayjs": "^1.11.19",
        "fossflow": "^1.0.5",
        "r": "^0.0.5",
        "react": "^18.3.1",
        "react-country-flag": "^3.1.0",
        "react-dom": "^18.3.1",
        "react-dropzone": "^15.0.0",
        "react-hook-form": "^7.71.2",
        "react-imask": "^7.6.1",
        "react-number-format": "^5.4.4",
        "react-router-dom": "^7.13.1",
        "swr": "^2.4.1",
        "tinycolor2": "^1.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@playwright/test": "^1.58.2",
        "@types/node": "^25.3.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.2.3",
        "eslint": "^9.39.3",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.9",
        "globals": "^17.4.0",
        "vite": "^7.3.1"
    }
}
